{
  "id": "com.anssafouzineb.xfltr",
  "name": "X-FLTR / THE VOID ENGINE",
  "version": "2.0.0",
  "manifestVersion": 5,
  "host": [
    {
      "app": "PS",
      "minVersion": "26.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "xfltr.panel",
      "label": {
        "default": "X-FLTR"
      },
      "minimumSize": {
        "width": 400,
        "height": 600
      },
      "maximumSize": {
        "width": 800,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 450,
        "height": 800
      },
      "preferredFloatingSize": {
        "width": 500,
        "height": 900
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "dark",
            "darkest"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "light",
            "lightest"
          ]
        }
      ]
    }
  ],
  "requiredPermissions": [
    {
      "name": "enablePluginWrite"
    },
    {
      "name": "clipboard"
    },
    {
      "name": "network",
      "domains": []
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-dark.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "dark",
        "darkest",
        "medium"
      ]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-light.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "lightest",
        "light"
      ]
    }
  ]
}
