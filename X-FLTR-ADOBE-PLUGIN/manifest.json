{
  "id": "com.anssafouzineb.xfltr",
  "name": "X-FLTR / THE VOID ENGINE",
  "version": "2.0.1",
  "manifestVersion": 4,
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "xfltr.panel",
      "label": {
        "default": "X-FLTR"
      },
      "minimumSize": {
        "width": 300,
        "height": 500
      },
      "maximumSize": {
        "width": 800,
        "height": 1000
      },
      "main": "index.html"
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "http://localhost:8000"
      ]
    }
  }
}